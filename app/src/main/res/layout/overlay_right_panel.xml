<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sliding_panel_right"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical|end"
    android:orientation="vertical"
    android:background="#80000000"
    android:padding="8dp"
    android:translationX="0dp"> <!-- Start visible -->

    <!-- Simulator ON/OFF switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_simulator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:text="@string/simulator_switch" />

    <!-- Virtual Stick ON/OFF switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_virtual_stick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:text="@string/virtual_stick_switch" />

    <!-- Force RTH button -->
    <Button
        android:id="@+id/button_force_rth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/force_rth_button"
        android:layout_gravity="center_vertical|start" />
</LinearLayout>
