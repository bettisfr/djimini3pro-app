<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen content: Camera stream or map -->
    <SurfaceView
        android:id="@+id/sv_camera_stream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <org.maplibre.android.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Left Overlay -->
    <include layout="@layout/overlay_left_panel" />

    <!-- Small sliding button -->
    <Button
        android:id="@+id/button_toggle_panel_left"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="-120dp"
        android:text="@string/slide_left"
        android:textSize="11sp"
        android:padding="2dp" />

    <!-- Right Overlay -->
    <include layout="@layout/overlay_right_panel" />

    <Button
        android:id="@+id/button_toggle_panel_right"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="0dp"
        android:layout_marginTop="-120dp"
        android:text="@string/slide_right"
        android:textSize="11sp"
        android:padding="2dp" />

    <!-- Map Button -->
    <Button
        android:id="@+id/button_toggle_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/map_button"
        android:layout_marginBottom="30dp"
        android:layout_gravity="bottom|end" />

    <!-- Top Overlay -->
    <include layout="@layout/overlay_top_status" />

    <!-- Bottom Overlay -->
    <include layout="@layout/overlay_bottom_log" />

</FrameLayout>
