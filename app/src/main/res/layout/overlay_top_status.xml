<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="#80000000"> <!-- 50% transparent gray -->

    <!-- Connected Status -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/connection_label"
        android:textColor="#FFFFFF"
        android:layout_gravity="start"
        android:padding="2dp" />

    <TextView
        android:id="@+id/textview_is_drone_connected"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/empty_label"
        android:textColor="#FFFFFF"
        android:layout_gravity="end"
        android:padding="2dp"
        android:layout_weight="1" /> <!-- Added layout_weight to keep position fixed -->

    <!-- Simulator Status -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/simulator_label"
        android:textColor="#FFFFFF"
        android:layout_gravity="start"
        android:padding="2dp" />

    <TextView
        android:id="@+id/textview_is_simulator_on"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/empty_label"
        android:textColor="#FFFFFF"
        android:layout_gravity="end"
        android:padding="2dp"
        android:layout_weight="1" /> <!-- Added layout_weight -->

    <!-- Battery Status -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/battery_label"
        android:textColor="#FFFFFF"
        android:layout_gravity="start"
        android:padding="2dp" />

    <TextView
        android:id="@+id/textview_battery"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/empty_label"
        android:textColor="#FFFFFF"
        android:layout_gravity="end"
        android:padding="2dp"
        android:layout_weight="1" /> <!-- Added layout_weight -->

    <!-- Drone Yaw -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/drone_yaw_label"
        android:textColor="#FFFFFF"
        android:layout_gravity="start"
        android:padding="2dp" />

    <TextView
        android:id="@+id/textview_drone_yaw"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/empty_label"
        android:textColor="#FFFFFF"
        android:layout_gravity="end"
        android:padding="2dp"
        android:layout_weight="1" /> <!-- Added layout_weight -->

    <!-- Gimbal Pitch -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
